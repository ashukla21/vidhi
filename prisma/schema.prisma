generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  threads   Thread[]
}

model Thread {
  id        String    @id @default(cuid())
  folderId  String?
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  folder    Folder?   @relation(fields: [folderId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String
  content   String
  toolCalls String?
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model AstroData {
  id               Int    @id @default(autoincrement())
  date             String
  time             Float
  tithi            String
  paksha           String
  horaPlanet       String
  panchak          String
  lagna            String
  moonRashi        String
  moonNakshatra    String
  moonPada         Int
  sunRashi         String
  sunNakshatra     String
  sunPada          Int
  marsRashi        String
  marsNakshatra    String
  marsPada         Int
  mercuryRashi     String
  mercuryNakshatra String
  mercuryPada      Int
  jupiterRashi     String
  jupiterNakshatra String
  jupiterPada      Int
  venusRashi       String
  venusNakshatra   String
  venusPada        Int
  saturnRashi      String
  saturnNakshatra  String
  saturnPada       Int
  rahuRashi        String
  rahuNakshatra    String
  rahuPada         Int
  ketuRashi        String
  ketuNakshatra    String
  ketuPada         Int

  @@index([date])
}
